<?xml version="1.0" encoding="utf-8"?>
<!-- ApnaCircle AndroidManifest.
     Sensitive permissions (SMS, CALL_LOG, background location) are
     restricted by Play Store — each needs a declaration + video
     justification at submission. See README "Play Store — sensitive
     permissions" before requesting them. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- SIM-call caller distance (v0.5): Android 10+ only delivers
         the ringing number to apps holding READ_CALL_LOG. Dart
         explains why first, then requests it. Play Store needs a
         declaration + video justification for CALL_LOG. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Offline location fallback (v0.3): the parent's phone reads
         APNACIRCLE LOC: SMS from the child's phone when the child
         has no data. SmsReceiver ignores every other SMS. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- NOTE (v0.6.3): BIND_ACCESSIBILITY_SERVICE is NOT a
         <uses-permission> — it belongs on the AppLockService
         <service> declaration below (it is a signature-level
         permission the system grants to the service). Listing it
         here did nothing and is removed. -->

    <application
        android:label="ApnaCircle"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Maps key comes from manifestPlaceholders (see
             android/app/build.gradle.kts): set MAPS_API_KEY in
             gradle.properties / local.properties on the build machine.
             Restrict the key in Google Cloud to this app + Maps SDK. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Offline SMS location (v0.3): SmsReceiver only acts on
             messages starting with "APNACIRCLE LOC:" — see
             SmsReceiver.kt. SMS_RECEIVED is delivered to any app
             holding RECEIVE_SMS (no need to be the default SMS app). -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <!-- SIM-change + boot auto-start (v0.5): BootReceiver checks
             the SIM fingerprint after every reboot and stores a
             pending event when it changed; the SMS receiver is
             manifest-registered, so offline SMS location works
             after a reboot without the app opening. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Device Admin — uninstall protection (v0.5). Enabling is
             the user's own tap on Android's system screen. Honest
             limit: admin cannot truly BLOCK uninstall — it forces
             deactivation first + an alert (see
             ApnaCircleDeviceAdminReceiver). -->
        <receiver
            android:name=".ApnaCircleDeviceAdminReceiver"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- App Lock enforcement (v0.6.3) — THIS WAS THE MISSING
             PIECE in v0.2–v0.6.2: AppLockService.kt existed but was
             never declared here, so Android could never bind it, it
             never appeared in Settings → Accessibility, and no
             locked app was ever blocked ("App lock nhi ho rhi").
             The user must enable it once in Settings → Accessibility
             → ApnaCircle App Lock; the app's Locks screen shows
             whether it is ON and opens those settings. -->
        <service
            android:name=".AppLockService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- Background location service (v0.6.4) — the plugin
             (flutter_foreground_task) does NOT declare its own
             service, so the app must. Android 14+ REQUIRES
             android:foregroundServiceType="location" or the service
             cannot start. No stopWithTask="true" on purpose: the
             service must survive the app being swiped away — that
             is the whole point for a family safety app. The
             service runs only while the member is in a circle with
             "Allow all the time" (see BackgroundLocationService);
             FOREGROUND_SERVICE_LOCATION permission is declared
             above. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false" />
        <!-- Dedicated PIN lock screen (v0.6.3): shown OVER a locked
             app by AppLockService. Native (not Flutter) so it opens
             instantly. noHistory + excludeFromRecents: leaving it
             never leaves the locked app behind in Recents. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/NormalTheme" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
